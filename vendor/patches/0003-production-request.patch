+/// ... and a package stored raw (`Level::Stored`): its image is as large as the data it
+/// carries, compressible or not, plus the Kraken layout's own tables.
+#[test]
+fn the_estimate_covers_a_stored_package() {
+    let src = TempDir::new("stored-src");
+    let out = TempDir::new("stored-out");
+    write_tree(src.path());
+    let mut x = 0x9E37_79B9_7F4A_7C15u64;
+    let noise: Vec<u8> = (0..8 << 20)
+        .map(|_| {
+            x ^= x << 13;
+            x ^= x >> 7;
+            x ^= x << 17;
+            x as u8
+        })
+        .collect();
+    std::fs::write(src.path().join("data/large.bin"), &noise).unwrap();
+    std::fs::write(src.path().join("data/zeros.bin"), vec![0u8; 4 << 20]).unwrap();
+    let request = BuildRequest {
+        time: Some((1_700_000_000, 0)),
+        level: ps5upload_fpkg::kraken::Level::Stored,
+        ..BuildRequest::production(src.path(), out.path())
+    };
+    let mut tree = FolderSource::open(src.path()).unwrap();
+    let prepared = build::prepare(&mut tree, &request, &mut BuildControl::default()).unwrap();
+    let path = out.path().join("stored.part");
+    let mut file = std::fs::OpenOptions::new()
+        .read(true)
+        .write(true)
+        .create_new(true)
+        .open(&path)
+        .unwrap();
+    let report = build::write_package(
+        &prepared,
+        &mut tree,
+        &mut file,
+        &path,
+        &mut |_| {},
+        &mut BuildControl::default(),
+    )
+    .unwrap();
+    assert!(report.verify.ok(), "{}", report.verify);
+    // Stored: the zeros take their full size too.
+    assert!(report.size > 12 << 20, "{} bytes", report.size);
+    assert!(
+        prepared.estimated_size() >= report.size,
+        "estimated {} for a package of {}",
+        prepared.estimated_size(),
+        report.size
+    );
+}
