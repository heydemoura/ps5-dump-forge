-            .map(|e| {
-                let e = e?;
-                let m = e.metadata()?;
-                Ok((
-                    e.file_name().to_string_lossy().into_owned(),
-                    m.is_dir(),
-                    m.len(),
-                ))
-            })
-            .collect()
-    }
-    fn label(&self) -> String {
-        "test server".to_string()
-    }
-}
