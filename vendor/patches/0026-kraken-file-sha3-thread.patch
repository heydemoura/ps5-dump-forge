+        let mut read = |p: &str, off: u64, len: usize| -> Result<Vec<u8>> {
+            let size = sizes.iter().find(|(q, _)| *q == p).unwrap().1;
+            Ok(data(p, size)[off as usize..off as usize + len].to_vec())
+        };
